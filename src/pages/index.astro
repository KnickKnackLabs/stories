---
import { getCollection } from 'astro:content';
import HeroGridGame from '../components/HeroGridGame.astro';
import StoryCard from '../components/StoryCard.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import Layout from '../layouts/Layout.astro';

const stories = (await getCollection('stories')).sort((a, b) => {
  const aTime = a.data.pubDate?.getTime() || 0;
  const bTime = b.data.pubDate?.getTime() || 0;
  return bTime - aTime;
});
---

<Layout>
  <main>
    <section class="hero">
      <div class="heroCopy">
        <p class="eyebrow">Knick Knack Labs</p>
        <h1>Stories about small experiments that might become useful things.</h1>
        <p>
          This is the future home for KKL stories: prototype writeups, interface explorations,
          tool notes, and the occasional weird little game.
        </p>
      </div>
      <HeroGridGame />
    </section>

    <section class="prototypeSection" aria-labelledby="prototype-heading">
      <div class="sectionHeader">
        <p class="eyebrow">Prototype lineage</p>
        <h2 id="prototype-heading">Live sketches</h2>
        <p>These prototypes open on GitHub Pages so Stories stays a small writing surface.</p>
      </div>

      <div class="prototypeGrid">
        <a
          class="prototypeTile"
          href="https://rho-ricon.github.io/github-grid-explorer-poc/"
          target="_blank"
          rel="noreferrer"
        >
          <span class="prototypeNumber">01</span>
          <strong>GitHub Grid Explorer</strong>
          <small>operational cockpit</small>
          <span class="prototypeCta" aria-hidden="true">Live demo ↗</span>
        </a>
        <a
          class="prototypeTile"
          href="https://rho-ricon.github.io/grow-heal-love-practice-explorer-poc/"
          target="_blank"
          rel="noreferrer"
        >
          <span class="prototypeNumber">02</span>
          <strong>Grow Heal Love</strong>
          <small>practice cockpit</small>
          <span class="prototypeCta" aria-hidden="true">Live demo ↗</span>
        </a>
        <a
          class="prototypeTile"
          href="https://rho-ricon.github.io/weird-grid-games-poc/"
          target="_blank"
          rel="noreferrer"
        >
          <span class="prototypeNumber">03</span>
          <strong>Weird Grid Games</strong>
          <small>kid-friendly toys</small>
          <span class="prototypeCta" aria-hidden="true">Live demo ↗</span>
        </a>
      </div>
    </section>

    <SubscribeForm />

    <section class="storyList" aria-labelledby="stories-heading">
      <div class="sectionHeader">
        <p class="eyebrow">Stories</p>
        <h2 id="stories-heading">First drafts</h2>
      </div>
      {stories.map((story) => <StoryCard story={story} />)}
    </section>
  </main>
</Layout>
