---
const { compact = false } = Astro.props;
const buttondownUsername = 'knickknacklabs';
const subscribeAction = `https://buttondown.com/api/emails/embed-subscribe/${buttondownUsername}`;
---

<section class:list={["subscribe", compact && "subscribeCompact"]}>
  <div>
    <p class="eyebrow">Mailing list</p>
    <h2>Get the next story</h2>
    <p>
      Knick Knack Labs is a small independent studio making useful things out of prototypes,
      agents, tools, and weird little interfaces. If you want to follow along while the work is
      still forming, subscribe below; we’ll send occasional KKL stories as we go.
    </p>
  </div>

  <form class="subscribeForm" action={subscribeAction} method="post">
    <label>
      <span>Email</span>
      <input type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
    </label>
    <input type="hidden" name="embed" value="1" />
    <input type="hidden" name="tag" value="stories-site" />
    <button type="submit">Subscribe</button>
  </form>

  <p class="finePrint">
    Uses Buttondown. You’ll get a confirmation email before anything is sent.
    Previously unsubscribed? <a href="https://buttondown.com/login?subscriber=1">Manage your subscription</a>.
  </p>
</section>
